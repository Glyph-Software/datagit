{
  "name": "@glyphsoftware/datagit-sdk",
  "version": "0.1.0",
  "description": "DataGit's TypeScript SDK: Git-style version control for rows in your own database",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "datagit",
    "version-control",
    "postgresql",
    "mysql",
    "audit",
    "grpc"
  ],
  "author": "Glyph Software",
  "license": "Apache-2.0",
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md"
  ],
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.14.1",
    "@types/node": "^26.4.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glyph-Software/datagit.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/Glyph-Software/datagit/tree/main/sdk",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
